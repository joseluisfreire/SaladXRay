#nullable disable
using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text.RegularExpressions;
using Spectre.Console;
using Spectre.Console.Rendering;

class Program
{
    static string lastWarning = "No recent errors detected in the current session.";
    static Queue<string> recentLogs = new Queue<string>(new[] { "Awaiting logs...", "", "", "" });
    static long lastLogPosition = 0;

    static string SaladLogDirectory =
        Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.CommonApplicationData), "Salad", "logs");

    // Regex compilada, com timestamp fixo no formato do Serilog
    static readonly Regex TimestampPrefixRegex =
        new Regex(@"^\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}\.\d+\s+[-+]\d{2}:\d{2}\s+\[(\w{3})\]\s+(.*)", RegexOptions.Compiled);

    static readonly Regex ScreenTimestampRegex =
        new Regex(@"^\d{4}-\d{2}-\d{2}\s+(\d{2}:\d{2}:\d{2})\.\d+\s+[-+]\d{2}:\d{2}\s+\[\w{3}\]\s+", RegexOptions.Compiled);

    const int MaxWarningLength = 300;

    static void Main()
    {
        string logFile = GetMostRecentLogFile(SaladLogDirectory);
        if (logFile == null)
        {
            Console.WriteLine("Nenhum log encontrado em: " + SaladLogDirectory);
            return;
        }

        LoadInitialLog(logFile);

        AnsiConsole.Live(RenderPanel())
            .Start(ctx =>
            {
                while (true)
                {
                    string current = GetMostRecentLogFile(SaladLogDirectory);
                    if (current != null) ReadNewLines(current);

                    ctx.UpdateTarget(RenderPanel());
                    ctx.Refresh();

                    if (Console.KeyAvailable && Console.ReadKey(true).Key == ConsoleKey.Escape) break;
                    System.Threading.Thread.Sleep(500);
                }
            });
    }

    static string GetMostRecentLogFile(string folder)
    {
        if (!Directory.Exists(folder)) return null;
        return new DirectoryInfo(folder).GetFiles("log-*.txt")
            .OrderByDescending(f => f.LastWriteTime).FirstOrDefault()?.FullName;
    }

    static void LoadInitialLog(string filePath)
    {
        try
        {
            using var fs = new FileStream(filePath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
            using var reader = new StreamReader(fs, System.Text.Encoding.UTF8);
            string line;
            while ((line = reader.ReadLine()) != null)
            {
                ProcessLine(line);
                if (!line.Contains("Progress(") && !line.Contains("Pull progress")) AddLogToScreen(line);
            }
            lastLogPosition = fs.Position;
        }
        catch { }
    }

    static void ReadNewLines(string filePath)
    {
        try
        {
            using var fs = new FileStream(filePath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
            if (fs.Length < lastLogPosition) lastLogPosition = 0;
            fs.Seek(lastLogPosition, SeekOrigin.Begin);
            using var reader = new StreamReader(fs, System.Text.Encoding.UTF8, true, 4096, leaveOpen: true);
            string line;
            while ((line = reader.ReadLine()) != null)
            {
                ProcessLine(line);
                if (line.Contains("Progress(") || line.Contains("Pull progress")) continue;
                AddLogToScreen(line);
            }
            lastLogPosition = fs.Position;
        }
        catch { }
    }

    // FIX: ignora linhas de continuaÃ§Ã£o (indentadas, sem timestamp real) e SEMPRE
    // trunca na origem, independente do regex bater ou nÃ£o. Evita vazamento de
    // strings gigantes vindas de blocos multi-linha tipo "Workload Instance States".
static void ProcessLine(string line)
{
    if (string.IsNullOrEmpty(line)) return;

    // Linha de continuação (indentada) - ainda pode conter erro real (ex: PullFailure)
    if (line[0] == '\t' || line[0] == ' ')
    {
        string trimmed = line.Trim();
        if (trimmed.Contains("PullFailure") || trimmed.Contains("failed") || trimmed.Contains("Error"))
        {
            lastWarning = trimmed.Length > MaxWarningLength
                ? trimmed.Substring(0, MaxWarningLength) + "..."
                : trimmed;
        }
        return;
    }

    var m = TimestampPrefixRegex.Match(line);
    if (!m.Success) return;

    string level = m.Groups[1].Value;
    string message = m.Groups[2].Value;

    if (level == "WRN" || level == "ERR" || message.Contains("failed"))
    {
        lastWarning = message.Length > MaxWarningLength
            ? message.Substring(0, MaxWarningLength) + "..."
            : message;
    }
}

    static void AddLogToScreen(string line)
    {
        if (string.IsNullOrWhiteSpace(line)) return;

        // Ignora tambÃ©m linhas de continuaÃ§Ã£o no feed de tela
        if (line[0] == '\t' || line[0] == ' ') return;

        string shortLine = ScreenTimestampRegex.Replace(line, "[$1] ");

        // Trunca na origem, nunca deixa string crua gigante entrar na queue
        if (shortLine.Length > MaxWarningLength)
            shortLine = shortLine.Substring(0, MaxWarningLength) + "...";

        if (recentLogs.Count >= 4) recentLogs.Dequeue();
        recentLogs.Enqueue($"[grey]{Markup.Escape(shortLine)}[/]");
    }

    static IRenderable RenderPanel()
    {
        var grid = new Grid().Expand();
        grid.AddColumn(new GridColumn());

        var logsArray = recentLogs.ToArray();
        var errorTable = new Table().HideHeaders().Border(TableBorder.None).Expand();
        errorTable.AddColumn(new TableColumn("Label").Width(15).NoWrap());
        errorTable.AddColumn(new TableColumn("Value").NoWrap());
        errorTable.AddRow(
            new Markup("[white]:warning: Last Error[/]"),
            new Markup($"[white]:[/] {TruncateWithColors($"[red]{Markup.Escape(lastWarning)}[/]", Math.Max(10, AnsiConsole.Profile.Width - 25))}")
        );

        int logMaxWidth = Math.Max(20, AnsiConsole.Profile.Width - 8);
        var logsBlock = new Markup(
            $"  {TruncateWithColors(logsArray.Length > 0 ? logsArray[0] : "", logMaxWidth)}\n" +
            $"  {TruncateWithColors(logsArray.Length > 1 ? logsArray[1] : "", logMaxWidth)}\n" +
            $"  {TruncateWithColors(logsArray.Length > 2 ? logsArray[2] : "", logMaxWidth)}\n" +
            $"  {TruncateWithColors(logsArray.Length > 3 ? logsArray[3] : "", logMaxWidth)}"
        );

        grid.AddRow(
            new Panel(new Rows(errorTable, logsBlock))
                .Header("[cyan][[ RECENT EVENTS ]][/]")
                .BorderColor(Color.Cyan)
                .Expand()
        );

        grid.AddRow(new Markup($"[grey]Console Width: {AnsiConsole.Profile.Width}[/]"));

        return grid;
    }

    static string TruncateWithColors(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return text;
        var result = new System.Text.StringBuilder();
        int visibleLength = 0; bool insideTag = false; int openTags = 0; bool isCut = false;
        for (int i = 0; i < text.Length; i++)
        {
            char c = text[i];
            if (c == '[' && i + 1 < text.Length && text[i + 1] == '[')
            {
                if (visibleLength < maxLength - 3) { result.Append("[["); visibleLength++; i++; continue; }
                else { isCut = true; break; }
            }
            if (c == ']' && i + 1 < text.Length && text[i + 1] == ']')
            {
                if (visibleLength < maxLength - 3) { result.Append("]]"); visibleLength++; i++; continue; }
                else { isCut = true; break; }
            }
            if (c == '[')
            {
                insideTag = true; result.Append('[');
                if (i + 1 < text.Length && text[i + 1] == '/') openTags--; else openTags++;
                continue;
            }
            if (insideTag) { result.Append(c); if (c == ']') insideTag = false; continue; }
            if (visibleLength < maxLength - 3) { result.Append(c); visibleLength++; }
            else { isCut = true; break; }
        }
        if (isCut) { result.Append("..."); for (int j = 0; j < Math.Max(0, openTags); j++) result.Append("[/]"); }
        return result.ToString();
    }
}
