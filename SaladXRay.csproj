<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ApplicationIcon>icone.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <Version>1.1.2</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.1.2.2026</FileVersion>
  <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  <TieredPGO>false</TieredPGO>
  <InvariantGlobalization>true</InvariantGlobalization>
  <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.ImageSharp" Version="0.57.2" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.10" />
    <PackageReference Include="System.Management" Version="10.0.10" />
	<EmbeddedResource Include="Fonts\*.flf" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

